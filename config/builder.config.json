{
  "$comment": "끝말잇기 사전 빌더 설정. 소스 추가/우선순위/검증 임계값을 여기서 관리한다.",
  "maxLoreLength": 60,
  "fallbackLore": "일반 어휘",
  "validation": {
    "minLength": 2,
    "maxLength": 40,
    "allowLatin": false,
    "allowDigits": true,
    "requireHangul": true,
    "requireChainable": true,
    "blocklist": [],
    "excludedPos": ["동사"]
  },
  "http": {
    "userAgent": "KkuttmalikkgiDictionaryBuilder/0.1 (+https://github.com/menonng/kkuttmalikkgi)",
    "timeoutMs": 15000,
    "retries": 3,
    "rateLimitMs": 150,
    "cacheTtlHours": 168
  },
  "paths": {
    "seeds": "data/seeds",
    "cache": "data/cache",
    "dist": "data/dist"
  },
  "sources": {
    "custom": {
      "enabled": true,
      "priority": 0
    },
    "genshin": {
      "enabled": true,
      "priority": 10,
      "lore": "원신",
      "options": {
        "categories": ["캐릭터", "지역", "무기"],
        "depth": 1,
        "limit": 2000
      }
    },
    "ars_goetia": {
      "enabled": true,
      "priority": 20,
      "lore": "악마학",
      "options": {
        "categories": ["악마"],
        "depth": 1,
        "limit": 500
      }
    },
    "mythology": {
      "enabled": true,
      "priority": 30,
      "options": {
        "categories": [
          "그리스 신화의 인물",
          "그리스 신화의 신",
          "북유럽 신화의 신",
          "이집트 신화의 신"
        ],
        "depth": 2,
        "limit": 4000
      }
    },
    "anime": {
      "enabled": true,
      "priority": 40,
      "lore": "애니메이션",
      "options": {
        "categories": ["애니메이션 등장인물", "만화 등장인물"],
        "depth": 2,
        "limit": 5000
      }
    },
    "light_novel": {
      "enabled": true,
      "priority": 50,
      "lore": "라이트노벨",
      "options": {
        "categories": ["라이트 노벨"],
        "depth": 2,
        "limit": 3000
      }
    },
    "movie": {
      "enabled": true,
      "priority": 60,
      "options": {
        "categories": ["대한민국의 영화 작품", "한국의 텔레비전 드라마"],
        "depth": 2,
        "limit": 5000
      }
    },
    "wikipedia": {
      "enabled": true,
      "priority": 80,
      "options": {
        "loreMode": "extract",
        "categories": ["조선의 왕", "고구려의 왕", "국제 기구"],
        "depth": 1,
        "limit": 3000
      }
    },
    "korean_dict": {
      "enabled": true,
      "priority": 90,
      "options": {
        "corpusFiles": [
          "data/corpus/korean-words.tsv",
          "data/corpus/korean-words.sample.tsv"
        ],
        "apiKeyEnv": "KOREAN_DICT_API_KEY",
        "$comment_queries": "KOREAN_DICT_API_KEY 가 있고 --online 일 때만 쓰인다. 19개 초성 x 받침 없는 기본 중성 10개(ㅏㅑㅓㅕㅗㅛㅜㅠㅡㅣ) 조합 190음절로 우리말샘을 넓게 훑는다 — 이 소스가 collect() 안에서 각 음절을 우리말샘 검색 API q= 로 그대로 보낸다(perQuery=1000 이므로 음절당 최대 10페이지). '5만개' 요청에 대응하는 실제 수집 경로이며, 실행하려면 opendict.korean.go.kr 에서 발급받은 키를 GitHub Actions 시크릿 KOREAN_DICT_API_KEY 로 등록해야 한다(.github/workflows/dictionary.yml refresh 잡이 매주 월요일 자동 실행).",
        "queries": [
          "가", "갸", "거", "겨", "고", "교", "구", "규", "그", "기",
          "까", "꺄", "꺼", "껴", "꼬", "꾜", "꾸", "뀨", "끄", "끼",
