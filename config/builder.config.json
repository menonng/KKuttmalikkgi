{
  "$comment": "끝말잇기 사전 빌더 설정. 소스 추가/우선순위/검증 임계값을 여기서 관리한다.",
  "maxLoreLength": 60,
  "fallbackLore": "일반 어휘",
  "validation": {
    "minLength": 2,
    "maxLength": 40,
    "allowLatin": false,
    "allowDigits": true,
    "requireHangul": true,
    "requireChainable": true,
    "blocklist": [],
    "excludedPos": ["동사"]
  },
  "http": {
    "userAgent": "KkuttmalikkgiDictionaryBuilder/0.1 (+https://github.com/menonng/kkuttmalikkgi)",
    "timeoutMs": 15000,
    "retries": 3,
    "rateLimitMs": 150,
    "cacheTtlHours": 168
  },
  "paths": {
    "seeds": "data/seeds",
    "cache": "data/cache",
    "dist": "data/dist"
  },
  "sources": {
    "custom": {
      "enabled": true,
      "priority": 0
    },
    "genshin": {
      "enabled": true,
      "priority": 10,
      "lore": "원신",
      "options": {
        "categories": ["캐릭터", "지역", "무기"],
        "depth": 1,
        "limit": 2000
      }
    },
    "ars_goetia": {
      "enabled": true,
      "priority": 20,
      "lore": "악마학",
      "options": {
        "categories": ["악마"],
        "depth": 1,
        "limit": 500
      }
    },
    "mythology": {
      "enabled": true,
      "priority": 30,
      "options": {
        "categories": [
          "그리스 신화의 인물",
          "그리스 신화의 신",
          "북유럽 신화의 신",
          "이집트 신화의 신"
        ],
        "depth": 2,
        "limit": 4000
      }
    },
    "anime": {
      "enabled": true,
      "priority": 40,
      "lore": "애니메이션",
      "options": {
        "categories": ["애니메이션 등장인물", "만화 등장인물"],
        "depth": 2,
        "limit": 5000
      }
    },
    "light_novel": {
      "enabled": true,
      "priority": 50,
      "lore": "라이트노벨",
      "options": {
        "categories": ["라이트 노벨"],
        "depth": 2,
        "limit": 3000
      }
    },
    "movie": {
      "enabled": true,
      "priority": 60,
      "options": {
        "categories": ["대한민국의 영화 작품", "한국의 텔레비전 드라마"],
        "depth": 2,
        "limit": 5000
      }
    },
    "wikipedia": {
      "enabled": true,
      "priority": 80,
      "options": {
        "loreMode": "extract",
        "categories": ["조선의 왕", "고구려의 왕", "국제 기구"],
        "depth": 1,
        "limit": 3000
      }
    },
    "korean_dict": {
      "enabled": true,
      "priority": 90,
      "options": {
        "corpusFiles": [
          "data/corpus/korean-words.tsv",
          "data/corpus/korean-words.sample.tsv"
        ],
        "apiKeyEnv": "KOREAN_DICT_API_KEY",
        "$comment_sweep": "KOREAN_DICT_API_KEY 가 있고 --online 일 때만 쓰인다. sweepAllSyllables=true 면 완성형 한글 음절 가~힣 11,172개를 전부 우리말샘 검색 API q= 로 보낸다(perQuery=1000 이면 음절당 최대 10페이지) — '수십만 단위' 수집의 실제 경로다. 음절 수 x 페이지 수만큼 요청이 나가므로(최악 111,720회, http.rateLimitMs=150ms 간격) 몇 시간이 걸릴 수 있다: 최초 1회는 GitHub Actions 에서 workflow_dispatch 로 수동 실행해 몰아서 돌리고, 그 뒤로는 매주 스케줄이 --incremental 로 이미 캐시된 요청은 건너뛴다. 실행하려면 opendict.korean.go.kr 에서 발급받은 키를 저장소 시크릿 KOREAN_DICT_API_KEY 로 등록해야 한다. queries 는 음절 스윕과 별개로 다글자 질의어를 추가하고 싶을 때 쓴다(기본은 비워 둠).",
        "sweepAllSyllables": true,
        "queries": [],
        "perQuery": 1000
      }
    }
  }
}
